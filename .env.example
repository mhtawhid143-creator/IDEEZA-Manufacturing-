# Copy to .env and fill in for local work. Never commit a filled-in .env.

# PostgreSQL connection string used by the app, the migrations and the seed.
DATABASE_URL="postgresql://user:password@localhost:5432/ideeza_manufacturing?schema=public"

# Session and password policy. All optional; the defaults are in docs/AUTH.md.
# AUTH_SESSION_IDLE_MINUTES=720
# AUTH_SESSION_ABSOLUTE_DAYS=30
# AUTH_SESSION_TOUCH_SECONDS=60
# AUTH_MAX_FAILED_ATTEMPTS=10
# AUTH_LOCK_MINUTES=15
# AUTH_SCRYPT_COST_LOG2=15

# Only for tools/verify-user-app.mjs, which provisions a throwaway password for
# the seeded accounts in a throwaway database. Not a production secret.
# VERIFY_PASSWORD=
