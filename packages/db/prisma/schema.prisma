enum DomainEventKind {
  rfq_submitted
  rfq_withdrawn
  rfq_recipient_viewed
  rfq_recipient_declined
  rfq_recipient_expired
  rfq_clarification_requested
  quote_submitted
  quote_revision_requested
  quote_revised
  quote_accepted
  quote_rejected
  quote_expired
  quote_withdrawn
  substitution_suggested
  substitution_approved
  substitution_rejected
  payment_initiated
  payment_secured
  payment_failed
  order_created
  order_confirmed
  order_production_started
  order_stage_advanced
  order_task_updated
  order_shipped
  order_delivered
  order_delivery_confirmed
  order_review_window_expired
