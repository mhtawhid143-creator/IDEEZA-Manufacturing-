// ---------------------------------------------------------------------------
// Party
// ---------------------------------------------------------------------------

model User {
  id          String    @id
  email       String    @unique
  displayName String
  role        ActorRole
  createdAt   DateTime  @default(now())
  suspendedAt DateTime?

  addresses         PostalAddress[]
  memberships       ManufacturerMember[]
  products          Product[]
  favoriteProducts  ProductFavorite[]
  rfqs              Rfq[]
  ordersAsBuyer     ManufacturingOrder[]
  payments          Payment[]
  uploadedFiles     FileRef[]
  threadMemberships MessageThreadParticipant[]
  messages          Message[]
  notifications     Notification[]
  reviews           Review[]
  refundsRequested  Refund[]
  disputesOpened    Dispute[]
  evidenceSubmitted Evidence[]
  domainEvents      DomainEvent[]
  inventoryMoves    InventoryMovement[]
  problemReports    ProblemReport[]
  credential        UserCredential?
  sessions          Session[]

  @@index([role])
}

/// Sign-in secret for a user. Kept out of the User row so that reading a user
/// never carries the hash with it.
model UserCredential {
  userId            String    @id
  passwordHash      String
  algorithm         String    @default("scrypt")
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A server side session. Only the hash of the token is stored, so a leaked
/// database row cannot be replayed as a session.
///
/// A manufacturer session must name the manufacturer it acts for: that is what
/// keeps one manufacturer out of another manufacturer's requests, quotes,
/// inventory and payouts. A database check constraint enforces it.
model Session {
  id                   String                   @id
  userId               String
  tokenHash            String                   @unique
  role                 ActorRole
  activeManufacturerId String?
  issuedAt             DateTime                 @default(now())
  lastSeenAt           DateTime                 @default(now())
  idleExpiresAt        DateTime
  absoluteExpiresAt    DateTime
  revokedAt            DateTime?
  revocationReason     SessionRevocationReason?
  userAgent            String?
  ipAddress            String?

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeManufacturer ManufacturerProfile? @relation(fields: [activeManufacturerId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@index([activeManufacturerId])
}

/// The buyer address book. Requests and orders keep their own inline snapshot
/// of the destination, so editing an entry here never rewrites history.
model PostalAddress {
  id          String    @id
  ownerId     String
  label       String?
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String?
  countryCode String    @db.Char(2)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model ManufacturerProfile {
  id                  String    @id
  legalName           String
  displayName         String
  addressLine1        String
  addressLine2        String?
  city                String
  region              String?
  postalCode          String?
  countryCode         String    @db.Char(2)
  rating              Decimal?  @db.Decimal(3, 2)
  onTimeDeliveryRate  Decimal?  @db.Decimal(5, 4)
  completedOrderCount Int       @default(0)
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())

  /// The line under the shop's name on its profile — one sentence, its own words.
  tagline String?
  /// The longer introduction the profile leads with.
  about   String?

  /// How a buyer reaches the shop outside the platform. Shown on the profile,
  /// which is why they are here and not on the member who happens to be signed in.
  phone      String?
  websiteUrl String?

  /// The band a shop describes its size by — "10-50" — rather than a headcount
  /// nobody keeps current.
  employeeBand    String?
  /// Carriers the shop ships with, as the profile lists them.
  shippingMethods String[] @default([])

  /// Where else a buyer can read about the shop. Absent is the common case and
  /// renders as nothing rather than as an empty row.
  facebookUrl  String?
  twitterUrl   String?
  instagramUrl String?
  linkedinUrl  String?

  capability       ManufacturerCapability?
  machines         ShopMachine[]
  capabilitySheets ShopCapabilitySheet[]
  articles         ShopArticle[]
  members          ManufacturerMember[]
  rfqRecipients    RfqRecipient[]
  quotes           Quote[]
  orders           ManufacturingOrder[]
  inventoryItems   InventoryItem[]
  inventoryAlerts  InventoryAlert[]
  payouts          Payout[]
  withdrawals      WithdrawalRequest[]
  reviews          Review[]
  domainEvents     DomainEvent[]
  sessions         Session[]

  @@index([countryCode])
}

model ManufacturerCapability {
  manufacturerId       String   @id
  services             String[]
  certifications       String[]
  servedRegions        String[]
  minimumOrderQuantity Int
  standardLeadTimeDays Int
  updatedAt            DateTime @updatedAt

  manufacturer ManufacturerProfile @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
}

model ManufacturerMember {
  id             String   @id
  manufacturerId String
  userId         String
  isOwner        Boolean  @default(false)
  createdAt      DateTime @default(now())

  manufacturer ManufacturerProfile @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([manufacturerId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Product and requirements
// ---------------------------------------------------------------------------

model Product {
  id           String              @id
  ownerId      String
  name         String
  availability ProductAvailability @default(available)
  createdAt    DateTime            @default(now())

  owner     User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files     ProductFile[]
  bomLines  BomLine[]
  packages  ManufacturingPackage[]
  favorites ProductFavorite[]

  @@index([ownerId])
  @@index([availability])
}

/// A product a buyer has kept. The favourites list is the buyer's own entry
/// point into manufacturing, so the row belongs to the buyer, not the product.
model ProductFavorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

/// An immutable pointer to one stored file revision. The storage provider is
/// not part of this task; only the record is.
model FileRef {
  id           String   @id
  name         String
  revision     Int      @default(1)
  contentHash  String
  byteSize     Int
  uploadedById String?
  uploadedAt   DateTime @default(now())

  uploadedBy         User?               @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  productLinks       ProductFile[]
  packageLinks       PackageFile[]
  requirementsLinks  RequirementsFile[]
  quoteAttachments   QuoteAttachment[]
  messageAttachments MessageAttachment[]
  evidence           Evidence[]

  @@unique([contentHash, revision])
}

model ProductFile {
  productId String
  fileId    String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  file    FileRef @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([productId, fileId])
}

/// Master bill-of-materials line owned by a product.
model BomLine {
  id                     String  @id
  productId              String
  reference              String
  componentName          String
  manufacturerPartNumber String?
  sku                    String?
  footprint              String?
  quantityPerUnit        Int

  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  packageLinks PackageBomLine[]

  @@unique([productId, reference])
  @@index([sku])
}

model ManufacturingPackage {
  id        String      @id
  productId String
  kind      PackageKind
  createdAt DateTime    @default(now())

  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  files        PackageFile[]
  bomLines     PackageBomLine[]
  requirements ManufacturingRequirements[]
  rfqs         Rfq[]

  @@index([productId, kind])
}

model PackageFile {
  packageId String
  fileId    String

  package ManufacturingPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  file    FileRef              @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([packageId, fileId])
}

model PackageBomLine {
  packageId String
  bomLineId String

  package ManufacturingPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  bomLine BomLine              @relation(fields: [bomLineId], references: [id], onDelete: Cascade)

  @@id([packageId, bomLineId])
}

/// The structured production boundary. A row is frozen once lockedAt is set,
/// which is the moment a request is submitted against it.
model ManufacturingRequirements {
  id                      String             @id
  packageId               String
  version                 Int                @default(1)
  quantity                Int
  material                String
  manufacturingMethod     String
  tolerance               String
  leadTimeDays            Int
  shippingRequirement     String
  assembly                AssemblyMode
  assemblySides           AssemblySides?
  qualityCheckRequirement String
  substitutionPolicy      SubstitutionPolicy
  notes                   String?
  /// The print specification, set only when the package includes a 3D module.
  /// A printer quotes on the process, the material and the finish, so these are
  /// their own columns rather than prose in the notes.
  printTechnology         PrintTechnology?
  printMaterial           String?
  printColor              String?
  surfaceFinish           SurfaceFinish?
  infillPercent           Int?
  lockedAt                DateTime?
  createdAt               DateTime           @default(now())

  package   ManufacturingPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  files     RequirementsFile[]
  boardSpec BoardSpecification?
  rfqs      Rfq[]

  @@unique([packageId, version])
}

/// The detailed board specification, one row per requirements version.
///
/// It is a document of its own rather than columns on the requirements: it only
/// applies to a package that contains a board, it is long, and it is frozen and
/// versioned with the requirements it belongs to. Every column is optional and a
/// missing value means "manufacturer's discretion", so a buyer is never forced
/// to invent a specification they do not have.
model BoardSpecification {
  requirementsId      String              @id
  baseMaterial        BaseMaterial?
  layerCount          Int?
  thicknessMm         Decimal?            @db.Decimal(3, 2)
  boardColor          BoardColor?
  silkscreenColor     SilkscreenColor?
  surfaceFinish       BoardSurfaceFinish?
  outerCopperOz       Decimal?            @db.Decimal(3, 1)
  innerCopperOz       Decimal?            @db.Decimal(3, 1)
  viaCovering         ViaCovering?
  minViaHoleMm        Decimal?            @db.Decimal(3, 2)
  outlineToleranceMm  Decimal?            @db.Decimal(3, 2)
  deliveryFormat      DeliveryFormat?
  distinctDesigns     Int?
  electricalTest      ElectricalTest?
  goldFingers         Boolean             @default(false)
  castellatedHoles    Boolean             @default(false)
  edgePlating         Boolean             @default(false)
  blindOrBuriedVias   Boolean             @default(false)
  ulMarking           UlMarking?
  markOnBoard         MarkOnBoard?
  workmanshipClass    WorkmanshipClass?
  packaging           BoardPackaging?
  /// Assembly detail. Only meaningful when the requirements ask for assembly.
  assembledFace       AssembledFace?
  partsSuppliedBy     SuppliedBy?
  toolingHolesAddedBy SuppliedBy?
  conformalCoating    Boolean             @default(false)
  functionalTest      Boolean             @default(false)
  /// Only meaningful when no assembly is asked for: the buyer populates it.
  stencilRequired     Boolean             @default(false)
  remarks             String?
  updatedAt           DateTime            @updatedAt
  createdAt           DateTime            @default(now())

  requirements ManufacturingRequirements @relation(fields: [requirementsId], references: [id], onDelete: Cascade)
}

model RequirementsFile {
  requirementsId String
  fileId         String

  requirements ManufacturingRequirements @relation(fields: [requirementsId], references: [id], onDelete: Cascade)
  file         FileRef                   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([requirementsId, fileId])
}

// ---------------------------------------------------------------------------
// Request for quotes
// ---------------------------------------------------------------------------

/// One request, routed to one or many manufacturers. Multiple recipients never
/// mean multiple orders: they mean competing quotes for the buyer to compare.
model Rfq {
  id                String    @id
  buyerId           String
  packageId         String
  requirementsId    String
  status            RfqStatus @default(draft)
  quantity          Int
  requestedServices String[]
  volumeTiers       Int[]
  targetPriceMinor  BigInt?
  currency          String    @db.Char(3)
  shipToLine1       String
  shipToLine2       String?
  shipToCity        String
  shipToRegion      String?
  shipToPostalCode  String?
  shipToCountryCode String    @db.Char(2)
  neededBy          DateTime?
  responseDeadline  DateTime?
  submittedAt       DateTime?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())

  buyer         User                      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  package       ManufacturingPackage      @relation(fields: [packageId], references: [id])
  requirements  ManufacturingRequirements @relation(fields: [requirementsId], references: [id])
  recipients    RfqRecipient[]
  items         RfqItem[]
  quotes        Quote[]                   @relation("RfqQuotes")
  acceptedQuote Quote?                    @relation("RfqAcceptedQuote")
  orders        ManufacturingOrder[]
  threads       MessageThread[]
  evidence      Evidence[]

  @@index([buyerId, status])
  @@index([status, createdAt])
  @@index([createdAt])
}

/// Per-manufacturer routing state. This row, not the request, is what a
/// manufacturer is allowed to read.
model RfqRecipient {
  id             String             @id
  rfqId          String
  manufacturerId String
  status         RfqRecipientStatus @default(routed)
  viewedAt       DateTime?
  quotedAt       DateTime?
  declinedAt     DateTime?
  declineReason  RfqDeclineReason?
  declineNote    String?
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())

  rfq          Rfq                 @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  manufacturer ManufacturerProfile @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@unique([rfqId, manufacturerId])
  @@index([manufacturerId, status])
  @@index([rfqId, status])
}

/// The bill of materials as sent with the request: the persisted form of the
/// requirements snapshot that every recipient quotes against.
model RfqItem {
  id                     String  @id
  rfqId                  String
  reference              String
  componentName          String
  manufacturerPartNumber String?
  sku                    String?
  quantityRequired       Int

  rfq           Rfq            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quoteItems    QuoteItem[]
  substitutions Substitution[]

  @@unique([rfqId, reference])
  @@index([sku])
}

// ---------------------------------------------------------------------------
// Quote
// ---------------------------------------------------------------------------

/// A manufacturer response carrying every term the buyer needs to compare it.
///
/// acceptedForRfqId is the database-level guarantee that a request can only ever
/// have one accepted quote: it is set to the request id on acceptance and is
/// unique, and PostgreSQL allows many NULLs in a unique column.
model Quote {
  id                    String      @id
  rfqId                 String
  manufacturerId        String
  status                QuoteStatus @default(draft)
  version               Int         @default(1)
  acceptedForRfqId      String?     @unique
  quantity              Int
  currency              String      @db.Char(3)
  unitPriceMinor        BigInt
  totalPriceMinor       BigInt
  shippingEstimateMinor BigInt?
  toolingSetupCostMinor BigInt?
  leadTimeDays          Int
  materialProcessNotes  String
  warrantyTerms         String?
  terms                 String
  expiresAt             DateTime
  submittedAt           DateTime?
  acceptedAt            DateTime?
  createdAt             DateTime    @default(now())

  rfq            Rfq                 @relation("RfqQuotes", fields: [rfqId], references: [id], onDelete: Cascade)
  acceptedForRfq Rfq?                @relation("RfqAcceptedQuote", fields: [acceptedForRfqId], references: [id])
  manufacturer   ManufacturerProfile @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  items          QuoteItem[]
  volumePrices   QuoteVolumePrice[]
  revisions      QuoteRevision[]
  substitutions  Substitution[]
  attachments    QuoteAttachment[]
  order          ManufacturingOrder?
  payments       Payment[]
  threads        MessageThread[]
  evidence       Evidence[]

  @@unique([rfqId, manufacturerId, version])
  @@index([rfqId, status])
  @@index([manufacturerId, status])
  @@index([status, expiresAt])
}

model QuoteItem {
  id             String  @id
  quoteId        String
  rfqItemId      String?
  description    String
  quantity       Int
  currency       String  @db.Char(3)
  unitPriceMinor BigInt
  lineTotalMinor BigInt

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rfqItem RfqItem? @relation(fields: [rfqItemId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

/// An immutable record of a superseded set of quote terms.
/// A price for one of the extra volumes the request asked to have priced.
///
/// The buyer asks for alternative quantities on the request; without somewhere to
/// put the answers the question could only be answered in prose, which is not
/// comparable. One row per volume, and the volume has to be one the request
/// actually asked for.
model QuoteVolumePrice {
  id              String @id
  quoteId         String
  quantity        Int
  currency        String @db.Char(3)
  unitPriceMinor  BigInt
  totalPriceMinor BigInt
  leadTimeDays    Int?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, quantity])
  @@index([quoteId])
}

model QuoteRevision {
  id                 String    @id
  quoteId            String
  version            Int
  requestedByBuyerAt DateTime?
  buyerNote          String?
  previousTerms      Json
  createdAt          DateTime  @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, version])
}

/// A manufacturer-suggested replacement part. It must be decided by the buyer,
/// and the decision becomes part of the documented order record.
model Substitution {
  id                       String             @id
  quoteId                  String
  rfqItemId                String
  status                   SubstitutionStatus @default(proposed)
  requestedPartReference   String
  suggestedPartName        String
  suggestedInventoryItemId String?
  technicalJustification   String
  currency                 String             @db.Char(3)
  priceImpactMinor         BigInt
  leadTimeImpactDays       Int
  decidedAt                DateTime?
  createdAt                DateTime           @default(now())

  quote                  Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rfqItem                RfqItem        @relation(fields: [rfqItemId], references: [id], onDelete: Cascade)
  suggestedInventoryItem InventoryItem? @relation(fields: [suggestedInventoryItemId], references: [id], onDelete: SetNull)

  @@unique([quoteId, rfqItemId])
  @@index([quoteId, status])
}

model QuoteAttachment {
  quoteId String
  fileId  String

  quote Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  file  FileRef @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([quoteId, fileId])
}

// ---------------------------------------------------------------------------
// Manufacturing order
// ---------------------------------------------------------------------------

/// An order exists only for an accepted quote, and the accepted quote can back
/// exactly one order (acceptedQuoteId is unique).
///
/// A database check constraint added in the migration additionally refuses any
/// row that has left awaiting_payment without a payment attached.
model ManufacturingOrder {
  id                 String         @id
  rfqId              String
  acceptedQuoteId    String         @unique
  buyerId            String
  manufacturerId     String
  paymentId          String?        @unique
  status             OrderStatus    @default(awaiting_payment)
  shipToLine1        String
  shipToLine2        String?
  shipToCity         String
  shipToRegion       String?
  shipToPostalCode   String?
  shipToCountryCode  String         @db.Char(2)
  shippingChoice     ShippingChoice @default(standard)
  reviewWindowEndsAt DateTime?
  confirmedAt        DateTime?
  deliveredAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime       @default(now())

  rfq            Rfq                    @relation(fields: [rfqId], references: [id])
  acceptedQuote  Quote                  @relation(fields: [acceptedQuoteId], references: [id])
  buyer          User                   @relation(fields: [buyerId], references: [id])
  manufacturer   ManufacturerProfile    @relation(fields: [manufacturerId], references: [id])
  payment        Payment?               @relation("OrderPayment", fields: [paymentId], references: [id])
  snapshot       AcceptedQuoteSnapshot?
  stages         ProductionStage[]
  tasks          ProductionTask[]
  alerts         InventoryAlert[]
  inventoryMoves InventoryMovement[]
  payouts        Payout[]
  evidence       Evidence[]
  refunds        Refund[]
  disputes       Dispute[]
  threads        MessageThread[]
  review         Review?
  domainEvents   DomainEvent[]

  @@index([buyerId, status])
  @@index([manufacturerId, status])
  @@index([status, createdAt])
  @@index([createdAt])
}

/// The frozen copy of what both sides agreed to.
///
/// Rows are append-only: the migration installs triggers that refuse UPDATE and
/// DELETE, because a dispute is decided on this record.
model AcceptedQuoteSnapshot {
  orderId                 String   @id
  quoteId                 String
  quoteVersion            Int
  manufacturerId          String
  quantity                Int
  currency                String   @db.Char(3)
  unitPriceMinor          BigInt
  totalPriceMinor         BigInt
  shippingEstimateMinor   BigInt?
  toolingSetupCostMinor   BigInt?
  leadTimeDays            Int
  materialProcessNotes    String
  warrantyTerms           String?
  terms                   String
  requirements            Json
  approvedSubstitutionIds String[]
  checksum                String
  capturedAt              DateTime @default(now())

  order ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

/// One of the ten canonical stages, tracked per order. Shop-floor detail is a
/// ProductionTask nested in a stage, never a stage of its own.
model ProductionStage {
  id          String                   @id
  orderId     String
  key         ProductionStageKey
  position    Int
  status      ProductionProgressStatus @default(pending)
  startedAt   DateTime?
  completedAt DateTime?
  note        String?

  order    ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tasks    ProductionTask[]
  evidence Evidence[]

  @@unique([orderId, key])
  @@unique([orderId, position])
  @@index([orderId, status])
  @@index([status])
}

model ProductionTask {
  id          String                   @id
  orderId     String
  stageId     String
  label       String
  position    Int
  status      ProductionProgressStatus @default(pending)
  startedAt   DateTime?
  completedAt DateTime?

  order ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage ProductionStage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, position])
  @@index([orderId])
  @@index([stageId, status])
}

// ---------------------------------------------------------------------------
// Inventory (manufacturer owned; buyers never read this table)
// ---------------------------------------------------------------------------

/// Why a stock number changed.
///
/// Stock is never a number somebody typed over: every change is one of these,
/// with what it was and what it became, so a shop can answer "where did those
/// parts go" and a count that disagrees with reality is itself a recorded event.
enum InventoryMovementKind {
  stock_in
  stock_out
  stock_count
  price_change
  reserved
  released
}

model InventoryMovement {
  id                String                @id
  itemId            String
  kind              InventoryMovementKind
  /// Signed change in stock. Zero for a price change.
  quantityDelta     Int                   @default(0)
  resultingStock    Int
  resultingReserved Int
  /// The new unit cost, on a price change.
  unitCostMinor     BigInt?
  effectiveFrom     DateTime?
  note              String?
  /// Set when the movement is a reservation for a confirmed order.
  orderId           String?
  actorUserId       String?
  occurredAt        DateTime              @default(now())

  item  InventoryItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  order ManufacturingOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([itemId, occurredAt])
  @@index([orderId])
}

model InventoryItem {
  id                   String    @id
  manufacturerId       String
  partName             String
  sku                  String
  category             String
  stockQuantity        Int       @default(0)
  reservedQuantity     Int       @default(0)
  lowStockThreshold    Int       @default(0)
  currency             String    @db.Char(3)
  unitCostMinor        BigInt
  leadTimeDays         Int
  minimumOrderQuantity Int?
  storageLocation      String?
  enabledForMatching   Boolean   @default(true)
  lastCountedAt        DateTime?
  updatedAt            DateTime  @updatedAt
  createdAt            DateTime  @default(now())

  manufacturer  ManufacturerProfile   @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  substitutes   InventorySubstitute[] @relation("InventoryItemSubstitutes")
  substituteFor InventorySubstitute[] @relation("InventoryItemSubstituteFor")
  substitutions Substitution[]
  orderAlerts   InventoryAlert[]
  movements     InventoryMovement[]

  @@unique([manufacturerId, sku])
  @@index([manufacturerId, category])
  @@index([manufacturerId, enabledForMatching])
}

model InventorySubstitute {
  itemId       String
  substituteId String

  item       InventoryItem @relation("InventoryItemSubstitutes", fields: [itemId], references: [id], onDelete: Cascade)
  substitute InventoryItem @relation("InventoryItemSubstituteFor", fields: [substituteId], references: [id], onDelete: Cascade)

  @@id([itemId, substituteId])
}

/// A shortage the manufacturer hit while making a confirmed order.
///
/// This is the one inventory row a buyer reads, and only through the order it
/// belongs to: it carries the shortfall, what the manufacturer suggests instead,
/// and what the buyer decided. The frozen snapshot is never edited, so the money
/// impact of the decision lives here and is settled as an adjustment.
model InventoryAlert {
  id                       String               @id
  orderId                  String
  raisedByManufacturerId   String
  partReference            String
  partName                 String
  shortfallQuantity        Int
  note                     String
  suggestedInventoryItemId String?
  suggestedPartName        String?
  technicalJustification   String?
  currency                 String               @db.Char(3)
  priceImpactMinor         BigInt               @default(0)
  creditMinor              BigInt               @default(0)
  leadTimeImpactDays       Int                  @default(0)
  restockLeadTimeDays      Int?
  status                   InventoryAlertStatus @default(open)
  decidedAt                DateTime?
  decisionNote             String?
  raisedAt                 DateTime             @default(now())

  order                  ManufacturingOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  raisedBy               ManufacturerProfile @relation(fields: [raisedByManufacturerId], references: [id], onDelete: Cascade)
  suggestedInventoryItem InventoryItem?      @relation(fields: [suggestedInventoryItemId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([raisedByManufacturerId, status])
}

// ---------------------------------------------------------------------------
// Money
// ---------------------------------------------------------------------------

/// Buyer funding held by the platform against one accepted quote.
model Payment {
  id                  String            @id
  quoteId             String
  buyerId             String
  status              PaymentStatus     @default(initiated)
  method              PaymentMethodKind
  currency            String            @db.Char(3)
  goodsAmountMinor    BigInt
  shippingAmountMinor BigInt            @default(0)
  taxAmountMinor      BigInt            @default(0)
  platformFeeMinor    BigInt            @default(0)
  discountAmountMinor BigInt            @default(0)
  promoCodeId         String?
  failureReason       String?
  totalChargedMinor   BigInt
  securedAt           DateTime?
  releasedAt          DateTime?
  createdAt           DateTime          @default(now())

  quote     Quote               @relation(fields: [quoteId], references: [id])
  buyer     User                @relation(fields: [buyerId], references: [id])
  order     ManufacturingOrder? @relation("OrderPayment")
  promoCode PromoCode?          @relation(fields: [promoCodeId], references: [id])
  payouts   Payout[]

  @@index([buyerId, status])
  @@index([quoteId])
  @@index([status, createdAt])
}

/// The manufacturer-facing side of the same money. releaseTriggerEventId points
/// at the documented order event that justified the release.
/// A discount code the platform issues. Either a percentage or a fixed amount
/// off the goods total, with an expiry and a redemption cap.
model PromoCode {
  id                String    @id
  code              String    @unique
  description       String
  percentOff        Int?
  amountOffMinor    BigInt?
  currency          String?   @db.Char(3)
  minimumSpendMinor BigInt?
  maxRedemptions    Int?
  redeemedCount     Int       @default(0)
  startsAt          DateTime?
  expiresAt         DateTime?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())

  payments Payment[]

  @@index([active, expiresAt])
}

model Payout {
  id                    String       @id
  orderId               String
  paymentId             String
  manufacturerId        String
  status                PayoutStatus @default(pending_release)
  currency              String       @db.Char(3)
  orderAmountMinor      BigInt
  platformFeeMinor      BigInt
  netAmountMinor        BigInt
  releaseTriggerEventId String?
  releasedAt            DateTime?
  createdAt             DateTime     @default(now())

  order               ManufacturingOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment             Payment             @relation(fields: [paymentId], references: [id])
  manufacturer        ManufacturerProfile @relation(fields: [manufacturerId], references: [id])
  releaseTriggerEvent DomainEvent?        @relation(fields: [releaseTriggerEventId], references: [id])

  @@unique([orderId])
  @@index([manufacturerId, status])
  @@index([status, createdAt])
}

model WithdrawalRequest {
  id             String           @id
  manufacturerId String
  status         WithdrawalStatus @default(requested)
  currency       String           @db.Char(3)
  amountMinor    BigInt
  requestedAt    DateTime         @default(now())
  settledAt      DateTime?

  manufacturer ManufacturerProfile @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@index([manufacturerId, status])
}

// ---------------------------------------------------------------------------
// Communication (always bound to a business object)
// ---------------------------------------------------------------------------

/// A thread cannot exist without a context: the migration adds a check
/// constraint that the context column matching contextKind is present.
model MessageThread {
  id            String             @id
  contextKind   MessageContextKind
  rfqId         String?
  quoteId       String?
  orderId       String?
  disputeId     String?
  lastMessageAt DateTime?
  createdAt     DateTime           @default(now())

  rfq          Rfq?                       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quote        Quote?                     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  order        ManufacturingOrder?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dispute      Dispute?                   @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  participants MessageThreadParticipant[]
  messages     Message[]

  @@index([contextKind])
  @@index([rfqId])
  @@index([orderId])
  @@index([lastMessageAt])
}

model MessageThreadParticipant {
  threadId   String
  userId     String
  joinedAt   DateTime  @default(now())
  /// When this participant last opened the thread, which is what makes an
  /// unread count possible without storing a read flag per message.
  lastReadAt DateTime?

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
}

/// Either human text or a system card that references a structured action. The
/// card references the event; it never carries the commitment itself.
model Message {
  id                String   @id
  threadId          String
  authorId          String?
  body              String?
  referencedEventId String?
  sentAt            DateTime @default(now())

  thread          MessageThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author          User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  referencedEvent DomainEvent?        @relation(fields: [referencedEventId], references: [id])
  attachments     MessageAttachment[]

  @@index([threadId, sentAt])
  @@index([sentAt])
}

model MessageAttachment {
  messageId String
  fileId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    FileRef @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([messageId, fileId])
}

model Notification {
  id          String    @id
  recipientId String
  kind        String
  title       String
  body        String
  deepLink    String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Records: events, evidence, reviews, resolution
// ---------------------------------------------------------------------------

/// Append-only log of structured business actions.
///
/// The migration installs triggers that refuse UPDATE and DELETE: this log is
/// the evidence base for payout release and dispute decisions.
model DomainEvent {
  id                  String           @id
  sequence            BigInt           @default(autoincrement())
  kind                DomainEventKind
  actorRole           ActorRole
  actorUserId         String?
  actorManufacturerId String?
  subjectKind         EventSubjectKind
  subjectId           String
  orderId             String?
  payload             Json             @default("{}")
  occurredAt          DateTime         @default(now())

  actorUser         User?                @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorManufacturer ManufacturerProfile? @relation(fields: [actorManufacturerId], references: [id], onDelete: SetNull)
  order             ManufacturingOrder?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payoutsReleased   Payout[]
  messages          Message[]

  @@index([subjectKind, subjectId])
  @@index([orderId, occurredAt])
  @@index([kind, occurredAt])
  @@index([occurredAt])
  @@index([sequence])
}

/// A piece of the documented record, bound to exactly one context. The
/// migration adds a check constraint enforcing that.
model Evidence {
  id                String              @id
  contextKind       EvidenceContextKind
  kind              EvidenceKind
  title             String
  rfqId             String?
  quoteId           String?
  orderId           String?
  productionStageId String?
  refundId          String?
  disputeId         String?
  fileId            String?
  payload           Json?
  submittedById     String?
  capturedAt        DateTime            @default(now())

  rfq             Rfq?                @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quote           Quote?              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  order           ManufacturingOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productionStage ProductionStage?    @relation(fields: [productionStageId], references: [id], onDelete: Cascade)
  refund          Refund?             @relation(fields: [refundId], references: [id], onDelete: Cascade)
  dispute         Dispute?            @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  file            FileRef?            @relation(fields: [fileId], references: [id], onDelete: SetNull)
  submittedBy     User?               @relation(fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([orderId, kind])
  @@index([contextKind])
  @@index([capturedAt])
}

model Review {
  id             String   @id
  orderId        String   @unique
  manufacturerId String
  authorId       String
  rating         Int
  body           String?
  anonymous      Boolean  @default(false)
  createdAt      DateTime @default(now())

  order        ManufacturingOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  manufacturer ManufacturerProfile @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  author       User                @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([manufacturerId, rating])
}

/// The financial outcome of an order issue.
model Refund {
  id                      String           @id
  orderId                 String
  requestedById           String
  status                  RefundStatus     @default(requested)
  reason                  OrderIssueReason
  currency                String           @db.Char(3)
  requestedAmountMinor    BigInt
  approvedAmountMinor     BigInt?
  description             String
  manufacturerRespondedAt DateTime?
  decidedAt               DateTime?
  createdAt               DateTime         @default(now())

  order       ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User               @relation(fields: [requestedById], references: [id])
  evidence    Evidence[]
  disputes    Dispute[]

  @@index([orderId, status])
  @@index([status, createdAt])
}

/// The process that resolves a contested order.
model Dispute {
  id                 String           @id
  orderId            String
  refundId           String?
  openedById         String
  status             DisputeStatus    @default(open)
  reason             OrderIssueReason
  currency           String           @db.Char(3)
  claimedAmountMinor BigInt
  outcome            DisputeOutcome?
  outcomeAmountMinor BigInt?
  resolvedAt         DateTime?
  createdAt          DateTime         @default(now())

  order    ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refund   Refund?            @relation(fields: [refundId], references: [id], onDelete: SetNull)
  openedBy User               @relation(fields: [openedById], references: [id])
  evidence Evidence[]
  threads  MessageThread[]

  @@index([orderId, status])
  @@index([status, createdAt])
}

/// What kind of trouble a report is about — the six the Figma dialog offers.
enum ProblemKind {
  technical_bug
  design_issue
  confusion
  performance
  feature_request
  other
}

/// How much the trouble is costing the person, in their own words.
enum ProblemFrustration {
  informational
  annoying
  blocking
}

/// A problem a panel member reported, from the "Report a Problem" dialog.
///
/// It is deliberately not attached to an order, a quote or a shop: the whole
/// point of the dialog is that it can be opened from anywhere, including a
/// screen whose data is what went wrong. What ties it to something is
/// `pageName`, which the dialog fills in from the route the reporter was on.
///
/// Nothing in the platform reads these rows yet — no ops panel exists to work
/// them. They are stored rather than posted somewhere because a report that
/// vanishes is worse than a form that says it cannot take one.
model ProblemReport {
  id           String             @id
  reportedById String
  kind         ProblemKind
  frustration  ProblemFrustration
  title        String
  detail       String
  extra        String?
  pageName     String
  attachments  Json               @default("[]")
  createdAt    DateTime           @default(now())

  reportedBy User @relation(fields: [reportedById], references: [id])

  @@index([reportedById, createdAt])
  @@index([kind, createdAt])
}

/// The kinds of work a capability sheet describes — the tabs the Figma
/// "Add Manufacturing Capability" flow offers.
enum CapabilityKind {
  pcb_fabrication
  pcb_assembly
  printing_3d
  cnc_machining
  injection_moulding
  other
}

/// One machine on the shop floor, with what it can do.
///
/// The shape is the Figma "Add Manufacturing Capability" form: the machine, the
/// process it performs, the sub-processes within that, the tolerance it holds
/// and how long a job on it takes. A buyer comparing two shops reads exactly
/// these five things, which is why they are five columns rather than a note.
///
/// Sub-processes are a list because one machine does several — a mill turns and
/// drills as well — and a buyer searching for one of them should find the
/// machine that offers it.
model ShopMachine {
  id             String   @id
  manufacturerId String
  /// What the machine is, from the list the form offers.
  name           String
  /// The process it performs.
  process        String
  /// The operations within that process.
  subProcesses   String[] @default([])
  /// The tolerance it holds, in the words the form offers.
  tolerance      String?
  /// Turnaround, as the shop writes it: "3-7 days".
  turnaroundTime String?
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  manufacturer ManufacturerProfile @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@index([manufacturerId, position])
}

/// Whether IDEEZA has checked a capability sheet, or has not yet.
///
/// Two states, because there are only two truths to tell: somebody at IDEEZA
/// has looked at the evidence, or nobody has yet. A sheet a shop has just
/// written is `pending` and says so on the card — a buyer reading "Verified"
/// on something nobody read would be the platform lending its name to a claim
/// it never checked.
enum CapabilityVerification {
  pending
  verified
}

/// One sheet of what a shop can actually do, per kind of work.
///
/// The platform matches requests on `ManufacturerCapability` — services,
/// regions, minimum quantity, lead time. These sheets are the detail a buyer
/// reads after the match: layer counts, tolerances, finishes. They do not gate
/// anything, which is why they are separate from the record that does.
model ShopCapabilitySheet {
  id              String                 @id
  manufacturerId  String
  kind            CapabilityKind
  title           String
  verification    CapabilityVerification @default(pending)
  /// The names of the files the shop attached as evidence. The files
  /// themselves are not stored anywhere yet, so the sheet records what was
  /// offered rather than pretending to hold it.
  attachmentNames String[]               @default([])
  position        Int                    @default(0)
  updatedAt       DateTime               @updatedAt

  manufacturer ManufacturerProfile       @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  parameters   ShopCapabilityParameter[]

  @@unique([manufacturerId, kind])
  @@index([manufacturerId, position])
}

/// One line of a sheet: "Surface finish" → ENIG, HASL.
///
/// The values are a list because a shop offers several and a buyer needs to see
/// all of them; joining them into a string would make them unsearchable later.
model ShopCapabilityParameter {
  id       String   @id
  sheetId  String
  label    String
  values   String[]
  position Int      @default(0)

  sheet ShopCapabilitySheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId, position])
}

/// Where an article stands. IDEEZA reads what a shop publishes to buyers, so a
/// draft is the shop's alone and a rejection carries the reason with it.
enum ArticleStatus {
  draft
  in_review
  published
  rejected
}

/// Something a shop wrote for buyers to read on its profile.
///
/// The blog screen and the profile's Blog tab are two views of this one table:
/// the screen is where it is written, the tab is what a buyer sees, and they
/// disagreeing was the reason the tab was passed an empty list.
model ShopArticle {
  id             String        @id
  manufacturerId String
  title          String
  category       String?
  tags           String[]      @default([])
  body           String
  status         ArticleStatus @default(draft)
  /// Why IDEEZA sent it back, when it did. Null in every other state.
  rejectReason   String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  manufacturer ManufacturerProfile @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@index([manufacturerId, status, createdAt])
}
