// IDEEZA Manufacturing Platform - persistence model.
//
// Scope of this file: tables, relationships, constraints and indexes only.
// Business rules, state transitions, invariants and permissions live in
// packages/domain and are NOT re-implemented here. Where a rule can also be
// expressed cheaply and exactly in the database it is added as a constraint, so
// that a bug in an application path cannot corrupt the record.
//
// Money convention: every amount is stored as an integer minor unit
// (<name>Minor, BigInt) together with a row-level ISO currency column. No
// floating point type is used for money anywhere in this schema.

generator client {
  provider      = "prisma-client-js"
  // The local machine, plus the Linux image Vercel builds and runs on. Without
  // the second the deployed app finds no query engine at runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumerations. These mirror packages/domain/src/status exactly; the database
// refuses any value the domain layer does not know.
// ---------------------------------------------------------------------------

enum ActorRole {
  buyer
  manufacturer
  ops_admin
}

enum SessionRevocationReason {
  signed_out
  rotated
  password_changed
  revoked_by_operations
  account_suspended
}

/// Whether a product may still be sent to manufacture. An unavailable product
/// stays readable and stays favourited; it simply cannot start a request.
enum ProductAvailability {
  available
  unavailable
}

enum PackageKind {
  pcb
  module_3d
  full_product
}

enum AssemblySides {
  single_side
  double_side
}

enum AssemblyMode {
  none
  smt
  through_hole
  mixed
}

/// How a printed or machined part is made. Only meaningful when the package
/// includes a 3D module, which is why every print column is optional.
enum PrintTechnology {
  fdm
  sla
  sls
  mjf
  cnc_machining
}

enum SurfaceFinish {
  as_printed
  sanded
  bead_blasted
  vapour_smoothed
  painted
}

/// The board specification a buyer may ask for.
///
/// Every list is vendor neutral on purpose: one request goes to several
/// manufacturers and they quote against it, so an option only one shop can
/// honour would make the quotes incomparable. A shop's own brand names and
/// internal workflow steps belong in its quote, not in the request.
enum BaseMaterial {
  fr4
  flex
  aluminium
  rogers
  ptfe_teflon
}

enum BoardColor {
  green
  black
  white
  blue
  red
  yellow
  purple
}

enum SilkscreenColor {
  white
  black
}

enum BoardSurfaceFinish {
  hasl_leaded
  hasl_lead_free
  enig
  osp
  immersion_silver
  hard_gold
}

enum ViaCovering {
  tented
  untented
  plugged
  epoxy_filled_capped
  copper_paste_filled_capped
}

enum DeliveryFormat {
  single_pcb
  panel_by_buyer
  panel_by_manufacturer
}

enum ElectricalTest {
  none
  sample
  flying_probe_full
  fixture_full
}

enum UlMarking {
  none
  any_position
  specified_position
}

enum MarkOnBoard {
  none
  order_number
  order_number_specified_position
  datamatrix_serial
}

enum WorkmanshipClass {
  ipc_class_2
  ipc_class_3
}

enum BoardPackaging {
  manufacturer_standard
  antistatic_bubble
  vacuum_esd_bag
}

enum AssembledFace {
  top
  bottom
}

enum SuppliedBy {
  buyer
  manufacturer
}

enum SubstitutionPolicy {
  not_allowed
  with_approval
  manufacturer_discretion
}

enum RfqStatus {
  draft
  submitted
  closed
  withdrawn
}

enum RfqRecipientStatus {
  routed
  viewed
  quoted
  declined
  expired
}

enum RfqDeclineReason {
  capability_mismatch
  capacity_unavailable
  below_minimum_order_quantity
  parts_unavailable
  lead_time_not_achievable
  files_incomplete
  destination_not_served
  other
}

enum QuoteStatus {
  draft
  submitted
  revision_requested
  revised
  accepted
  rejected
  expired
  withdrawn
}

enum SubstitutionStatus {
  proposed
  approved
  rejected
}

/// How a shortage raised during production was settled.
///
/// A shortage found after the snapshot was frozen cannot silently change the
/// agreed terms, so the buyer answers it in one of three ways and the answer is
/// what the record carries.
enum InventoryAlertStatus {
  open
  substitute_approved
  part_dropped
  stock_awaited
}

enum OrderStatus {
  awaiting_payment
  confirmed
  in_production
  quality_check
  ready_to_ship
  shipped
  delivered
  completed
  cancel_requested
  cancelled
  refund_requested
  refunded
  partially_refunded
  disputed
  resolved
}

enum ProductionStageKey {
  quote_accepted
  payment_secured
  files_under_review
  materials_confirmed
  in_production
  quality_check
  ready_to_ship
  shipped
  delivered
  completed
}

enum ProductionProgressStatus {
  pending
  in_progress
  completed
}

enum PaymentStatus {
  initiated
  secured
  released
  refunded
  partially_refunded
}

/// How the units travel. Chosen at checkout, priced on the order.
enum ShippingChoice {
  standard
  express
}

enum PaymentMethodKind {
  card
  paypal
  bank
  stablecoin
  platform_token
}

enum PayoutStatus {
  pending_release
  released
  refunded
  disputed
}

enum WithdrawalStatus {
  requested
  paid
  rejected
}

enum RefundStatus {
  requested
  mfr_responded
  ops_review
  approved
  partial
  rejected
}

enum DisputeStatus {
  open
  responded
  under_review
  resolved
  escalated
