# Copy to .env and point at a local PostgreSQL 15+ database.
# Never commit the real .env file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ideeza_manufacturing?schema=public"

# Used by the database test suite. It is dropped and recreated on every run, so
# it must never point at a database that holds anything you care about.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ideeza_manufacturing_test?schema=public"
