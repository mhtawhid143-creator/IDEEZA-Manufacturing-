# pnpm fails an install when a dependency has a build script it decided not to
# run. Every @embedded-postgres platform package has one, and none of them is
# needed: the harnesses use only the package for the machine they run on, and its
# binaries ship inside the package. Which scripts are deliberately skipped is
# recorded in package.json under pnpm.ignoredBuiltDependencies; this line stops
# that decision from failing the install.
#
# On this machine the skip had already been recorded in node_modules, so nothing
# complained. On a clean machine — a deployment, CI, a fresh clone — the install
# exited 1 before the build began.
strict-dep-builds=false

strict-peer-dependencies=false
auto-install-peers=true
