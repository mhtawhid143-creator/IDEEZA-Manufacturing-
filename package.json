{
  "name": "ideeza-manufacturing",
  "private": true,
  "version": "0.1.0",
  "description": "IDEEZA Manufacturing Platform monorepo",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm -r --if-present run build",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "verify:user-app": "node tools/verify-user-app.mjs",
    "verify:manufacturer-app": "node tools/verify-manufacturer-app.mjs",
    "review": "node tools/review-environment.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.17.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "@ideeza/auth": "workspace:*",
    "@ideeza/db": "workspace:*",
    "@prisma/client": "^6.19.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/linux-arm",
      "@embedded-postgres/linux-arm64",
      "@embedded-postgres/linux-ia32",
      "@embedded-postgres/linux-ppc64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/windows-x64"
    ]
  }
}
